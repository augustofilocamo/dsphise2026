        {
          "Type": "ProjectInfo"
        },
        {
          "Type": "MarkdownText",
          "Text": "Welcome to the installer of the $product $version.\n\n> This installer will guide you through the installation of the plug-in and standalone versions and necessary and assets.",
          "Style": "gap: 10px;"
        }
      ],
      "Text": ""
    },
    {
      "Type": "List",
      "Children": [
        {
          "Type": "MarkdownText",
          "Text": "Please read and accept the TOC\n\n"
        },
        {
          "Type": "TextInput",
          "ID": "eula",
          "InitValue": "${eula}",
          "UseInitValue": true,
          "NoLabel": true,
          "Height": "200",
          "Multiline": true,
          "Enabled": false,
          "Text": "",
          "Style": "color: #222; background: white;"
        },
        {
          "Type": "Button",
          "Text": "I have read and accepted the TOC",
          "ID": "ButtonId",
          "NoLabel": true,
          "Required": true,
          "InitValue": "0",
          "UseInitValue": true
        }
      ],
      "Text": "",
      "Style": "gap: 10px;"
    },
    {
      "Type": "List",
      "Children": [
        {
          "Type": "ProjectInfo"
        },
        {
          "Type": "OperatingSystem"
        },
        {
          "Type": "Branch",
          "ID": "OS",
          "Children": [
            {
              "Type": "List",
              "Children": []
            },
            {
              "Type": "List",
              "Children": [
                {
                  "Type": "MarkdownText",
                  "Text": "Please select the destination where you want to install the VST3 plugin:"
                },
                {
                  "Type": "PluginDirectories"
                },
                {
                  "Type": "RelativeFileLoader",
                  "ID": "programFilesDirectory",
                  "SpecialLocation": "globalApplicationsDirectory",
                  "RelativePath": "$company\\\\$product"
                },
                {
                  "Type": "RelativeFileLoader",
                  "ID": "appdataDirectory",
                  "SpecialLocation": "projectAppDataDirectory"
                },
                {
                  "Type": "FileSelector",
                  "ID": "vst3Directory",
                  "UseInitValue": "",
                  "Text": "Vst3 Location"
                },
                {
                  "Type": "UnzipTask",
                  "Text": "Progress",
                  "ID": "UnzipLink",
                  "Source": "${linkWin}",
                  "Target": "$appdataDirectory",
                  "Overwrite": true,
                  "Visibility": "Hidden"
                },
                {
                  "Type": "CopyAsset",
                  "Text": "Vst3",
                  "ID": "extractVST3",
                  "EventTrigger": "OnSubmit",
                  "Overwrite": true,
                  "Source": "${vst3Windows}",
                  "Target": "$vst3Directory"
                },
                {
                  "Type": "CopyAsset",
                  "ID": "CopyAssetViolas",
                  "Source": "${cellos}",
                  "Target": "$programFilesDirectory/Samples",
                  "Visibility": "Hidden",
                  "EventTrigger": "OnSubmit"
                },
                {
                  "Type": "CopyAsset",
                  "ID": "CopyAssetSmpclv",
                  "Source": "${smpclv}",
                  "Target": "$programFilesDirectory/Samples",
                  "Visibility": "Hidden",
                  "EventTrigger": "OnSubmit"
                },
                {
                  "Type": "CopyAsset",
                  "Text": "App",
                  "ID": "copyApp",
                  "Overwrite": true,
                  "Source": "${appWindows}",
                  "Target": "$programFilesDirectory",
                  "Visibility": "Default",
                  "EventTrigger": "OnSubmit"
                },
                {
                  "Type": "CopyAsset",
                  "ID": "CopyAssetPiano",
                  "Source": "${piano}",
                  "Target": "$programFilesDirectory/Samples",
                  "Visibility": "Hidden",
                  "EventTrigger": "OnSubmit"
                },
                {
                  "Type": "CopyAsset",
                  "ID": "CopyAssetMid",
                  "Source": "${middat}",
                  "Target": "$appdataDirectory",
                  "Visibility": "Hidden",
                  "EventTrigger": "OnSubmit"
                },
                {
                  "Type": "CopyAsset",
                  "ID": "CopyAssetAud",
                  "Source": "${auddat}",
                  "Target": "$appdataDirectory",
                  "Visibility": "Hidden",
                  "EventTrigger": "OnSubmit"
                }
              ],
              "Text": "",
              "ID": "Windows"
            },
            {
              "Type": "List",
              "ID": "macOS",
              "Style": "gap: 10px;",
              "Children": [],
              "Text": ""
            }
          ]
        }
      ]
    },
    {
      "Type": "List",
      "Children": [
        {
          "Type": "ProjectInfo"
        },
        {
          "Type": "MarkdownText",
          "Text": "Thanks for installing $product."
        },
        {
          "Type": "Branch",
          "Children": [
            {
              "Type": "List",
